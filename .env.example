# Browser requests use this prefix. Keep the default when using Vite's dev proxy.
VITE_API_BASE_URL=/api/v1

# Vite proxies VITE_API_BASE_URL to this origin during local development.
# 必须与后端实际监听地址一致：后端内置默认 :8080，../stock-flow/.env.example 提供 :8181。
VITE_API_PROXY_TARGET=http://localhost:8181

# 仅开发：设为 true 时「系统设置」出现 API 测试页（会真实变更库存数据）。
# 关闭（或删除）后菜单项不渲染，/settings/api-test 路由不存在，直接访问会落入 404。
# 构建期变量，修改后需重启 dev server 或重新构建。
# VITE_ENABLE_API_TEST=true
